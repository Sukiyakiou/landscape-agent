# ============================================================
# 用法：
#   1. 在终端执行  copy .env.example .env
#   2. 用记事本打开 .env，填入自己的 key
#   3. 只保留一个方案，另一个注释掉（行首加 #）
#
# 注意：.env 已被 .gitignore 忽略，永远不会上传到 GitHub。
#       本文件（.env.example）只是模板，里面没有真实 key。
# ============================================================

# ---------- 方案 A：DeepSeek（需充值，约 10 元起，主力） ----------
LLM_API_KEY=sk-your-deepseek-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---------- 方案 B：智谱 GLM-4-Flash（免费，适合先跑通） ----------
# 想用方案 B：把上面方案 A 的三行前面加 #，把下面三行的 # 去掉
# LLM_API_KEY=your-zhipu-api-key-here
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
